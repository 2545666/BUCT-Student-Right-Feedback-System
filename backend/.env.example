# ============================================
# 北京化工大学国际教育学院 - 学生权益反馈系统
# 环境配置文件
# ============================================

# 服务器配置
PORT=3101
NODE_ENV=development

# MongoDB数据库配置
MONGODB_URI=mongodb://localhost:27017/buct_feedback

# JWT配置
JWT_SECRET=your-super-secret-jwt-key-change-in-production-buct-2024
JWT_EXPIRE=7d

# CORS配置
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# 安全配置
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_ATTEMPTS_MAX=5
LOCK_TIME_MS=1800000

# 文件上传配置
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads

# 日志配置
LOG_LEVEL=info

# 邮箱验证码 SMTP 配置
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-authorization-code
SMTP_FROM=SIEHUB <no-reply@siehub.local>

# 本地开发不配置 SMTP_HOST / SMTP_USER / SMTP_PASS 时，验证码会输出在后端运行日志中。
